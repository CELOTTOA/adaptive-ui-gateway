{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aug:schema:invocation:0.2",
  "type": "object", "additionalProperties": false,
  "required": ["protocolVersion", "id", "operationId", "operationVersion", "revision", "state"],
  "properties": {
    "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "operationVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "state": { "enum": ["awaiting_confirmation", "running", "succeeded", "failed", "expired", "indeterminate"] },
    "confirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "expiresAt", "input"],
      "properties": {
        "token": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expiresAt": { "type": "number", "minimum": 0 },
        "input": { "type": "object", "additionalProperties": { "$ref": "urn:aug:schema:output:0.2#/$defs/jsonValue" } }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "outputId", "audience", "representation"],
      "properties": {
        "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "outputId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "audience": { "enum": ["view", "model"] },
        "representation": { "$ref": "urn:aug:schema:output:0.2#/properties/representations/items" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 100 } }
    }
  },
  "oneOf": [
    { "properties": { "state": { "const": "awaiting_confirmation" }, "confirmation": {}, "output": false, "error": false }, "required": ["confirmation"] },
    { "properties": { "state": { "const": "running" }, "confirmation": false, "output": false, "error": false } },
    { "properties": { "state": { "const": "succeeded" }, "confirmation": false, "output": {}, "error": false }, "required": ["output"] },
    { "properties": { "state": { "const": "failed" }, "confirmation": false, "output": false, "error": {} }, "required": ["error"] },
    { "properties": { "state": { "const": "expired" }, "confirmation": false, "output": false, "error": false } },
    { "properties": { "state": { "const": "indeterminate" }, "confirmation": false, "output": false,
      "error": { "type": "object", "required": ["code"], "properties": { "code": { "const": "EXECUTION_OUTCOME_UNKNOWN" } } } }, "required": ["error"] }
  ]
}
