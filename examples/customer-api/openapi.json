{
  "openapi": "3.0.3",
  "info": {
    "title": "Synthetic customer API",
    "version": "1.0.0"
  },
  "paths": {
    "/customers": {
      "get": {
        "operationId": "listCustomers",
        "summary": "Customer search",
        "description": "Search synthetic customer records by name or city",
        "x-aug-id": "demo.customers.list",
        "x-aug-title": "Customer search",
        "x-aug-effect": "read",
        "x-aug-required-scopes": ["customers:read"],
        "x-aug-classification": "internal",
        "x-aug-version": "1",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 200 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Customer" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "x-aug-classification": "internal"
          },
          "name": {
            "type": "string",
            "x-aug-classification": "internal"
          },
          "city": {
            "type": "string",
            "x-aug-classification": "internal"
          },
          "amountDue": {
            "type": "number",
            "x-aug-classification": "internal"
          },
          "internalNotes": {
            "type": "string",
            "x-aug-classification": "restricted",
            "x-aug-required-scopes": ["customers:sensitive"]
          },
          "tenantId": {
            "type": "string",
            "x-aug-classification": "confidential"
          }
        }
      }
    }
  }
}
