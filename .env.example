# Optional: copy this file to .envlocal. The default demo needs no API key.
# Leaving GROK_API_KEY empty uses the deterministic planner.
GROK_API_KEY=
# Override the model with one available to your provider account when needed.
# XAI_MODEL=
PLANNER_TIMEOUT_MS=10000

# Optional identity for the local synthetic MCP example, not remote authentication.
AUG_PRINCIPAL_ID=demo-analyst
AUG_TENANT_ID=tenant-a
AUG_SCOPES=customers:read

# Optional separate checkout for the Archteathos adapter/tests.
# ARCHTEATHOS_ROOT=/absolute/path/to/Archteathos
# AUG_PORT=4001
