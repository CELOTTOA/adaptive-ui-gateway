# Optional: copy this file to .envlocal. The default demo needs no API key.
# Leaving GROK_API_KEY empty uses the deterministic planner.
GROK_API_KEY=
# Override the model with one available to your provider account when needed.
# XAI_MODEL=
PLANNER_TIMEOUT_MS=10000

# Optional identity overrides for the synthetic MCP example, not remote authentication.
# AUG_PRINCIPAL_ID=demo-analyst
# AUG_TENANT_ID=tenant-a
# AUG_SCOPES=customers:read

# External MCP backend: all settings below are required together.
# Absolute paths are recommended. Both tokens must be distinct and at least 16 characters.
# AUG_OPENAPI_FILE=/absolute/path/to/backend.openapi.json
# AUG_BACKEND_URL=http://127.0.0.1:4102
# AUG_BACKEND_TOKEN=
# AUG_ACCESS_TOKEN=
# AUG_PRINCIPAL_ID=backend-reader
# AUG_TENANT_ID=your-tenant
# AUG_SCOPES=your:read
# AUG_ENV_FILE selects a different local env file; an empty value disables env-file loading.

# Optional separate checkout for the Archteathos adapter/tests.
# ARCHTEATHOS_ROOT=/absolute/path/to/Archteathos
# AUG_PORT=4001
